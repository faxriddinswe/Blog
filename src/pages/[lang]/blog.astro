---
import { Image } from "astro:assets";
import { articles as allArticles } from "@/data/articles";
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import PageIntro from "@/components/PageIntro.astro";
import CategoryTiles from "@/components/CategoryTiles.astro";
import { medium, socials } from "@/data/site";
import { formatDate, langPaths, t, type Locale } from "@/i18n/ui";

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;

const articles = [...allArticles].sort((a, b) => b.date.localeCompare(a.date));
const linkedin = socials.find((s) => s.id === "linkedin")!.href;
const platforms = [
  { id: "medium", name: "Medium", profile: medium },
  { id: "linkedin", name: "LinkedIn", profile: linkedin },
] as const;
const groups = platforms.map((p) => ({ ...p, items: articles.filter((a) => a.platform === p.id) }));
const ext = t(lang, "external");
---

<Base lang={lang} page="blog" title={t(lang, "blog.meta.title")} description={t(lang, "blog.meta.description")}>
  <div class="container page">
    <PageIntro title={t(lang, "blog.h1")} lead={t(lang, "blog.lead")} />
    <CategoryTiles
      label={t(lang, "blog.h1")}
      tiles={groups.map((g) => ({
        href: `#${g.id}`,
        label: g.name,
        count: t(lang, "items", { n: g.items.length }),
        icon: g.id,
      }))}
    />

    {
      groups.map((g) => (
        <section id={g.id} class="section" aria-labelledby={`${g.id}-title`}>
          <h2 id={`${g.id}-title`} class="h2 section-head">
            {g.name}
          </h2>
          {g.items.length > 0 ? (
            <div class="grid cards">
              {g.items.map((a) => (
                <article class="acard card">
                  <a class="acard__cover" href={a.url} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
                    {a.cover ? (
                      <Image src={a.cover} alt="" widths={[320, 640]} sizes="(min-width: 768px) 360px, 92vw" />
                    ) : (
                      <span class="gen">
                        <span class="gen__icon"><Icon name={g.id} size={24} /></span>
                        <span class="gen__title">{a.title[lang]}</span>
                      </span>
                    )}
                  </a>
                  <div class="acard__body">
                    <h3 class="acard__title">{a.title[lang]}</h3>
                    <p class="acard__meta">
                      <span class="pill badge">{g.name}</span>
                      <time class="muted" datetime={a.date}>
                        {formatDate(lang, a.date)}
                      </time>
                    </p>
                    <a class="btn btn--accent acard__btn" href={a.url} target="_blank" rel="noopener noreferrer">
                      {t(lang, `blog.read.${g.id}`)}
                      <Icon name="external" />
                      <span class="sr-only">({ext})</span>
                    </a>
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <div class="empty card">
              <span class="empty__icon" aria-hidden="true">
                <Icon name={g.id} size={28} />
              </span>
              <p class="muted">{t(lang, `blog.empty.${g.id}`)}</p>
              <a class="btn" href={g.profile} target="_blank" rel="noopener noreferrer">
                {t(lang, "blog.profile")}
                <Icon name="external" />
                <span class="sr-only">({ext})</span>
              </a>
            </div>
          )}
        </section>
      ))
    }
  </div>
</Base>

<style>
  .cards {
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }

  .acard {
    display: flex;
    flex-direction: column;
    padding: 10px;
  }

  .acard__cover {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    border-radius: 12px;
    overflow: hidden;
    background: var(--surface-2);
    color: var(--muted);
  }

  /* Generated cover when the article has no image. */
  .gen {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    height: 100%;
    padding: 16px;
    background:
      radial-gradient(90% 80% at 100% 0%, var(--accent-soft), transparent 60%),
      linear-gradient(var(--border) 1px, transparent 1px) 0 0 / 22px 22px,
      linear-gradient(90deg, var(--border) 1px, transparent 1px) 0 0 / 22px 22px,
      var(--surface-2);
    color: var(--text);
  }

  .gen__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .gen__title {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 18px;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.3px;
  }

  .acard__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .acard__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 10px;
    padding: 14px 6px 6px;
  }

  .acard__title {
    font-size: 16px;
    font-weight: 700;
    line-height: 1.4;
  }

  .acard__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-size: 13px;
  }

  .badge {
    padding: 2px 10px;
    background: var(--accent-soft);
    font-weight: 600;
  }

  .acard__btn {
    align-self: flex-start;
    margin-top: auto;
  }

  .empty {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    padding: 24px;
  }

  .empty p {
    flex: 1 1 240px;
  }

  .empty__icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: var(--surface-2);
    color: var(--muted);
  }

  @media (max-width: 559px) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
