---
import Icon, { type IconName } from "@/components/Icon.astro";

interface Props {
  label: string;
  tiles: { href: string; label: string; count: string; icon: IconName }[];
}
const { label, tiles } = Astro.props;
---

<nav class="tiles" aria-label={label}>
  <ul class="tiles__list">
    {
      tiles.map((tile) => (
        <li>
          <a class="tile" href={tile.href}>
            <span class="tile__box surface">
              <Icon name={tile.icon} size={34} />
            </span>
            <span class="tile__label">{tile.label}</span>
            <span class="tile__count muted">{tile.count}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .tiles {
    margin-top: 32px;
  }

  .tiles__list {
    display: flex;
    gap: 16px;
  }

  .tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 120px;
    text-align: center;
    border-radius: 20px;
  }

  .tile__box {
    display: grid;
    place-items: center;
    width: 120px;
    height: 120px;
    border-radius: 20px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--accent-text);
    transition: border-color var(--t), transform var(--t), background-color var(--t);
  }

  .tile:hover .tile__box {
    border-color: var(--accent-line);
    transform: translateY(-2px);
  }

  .tile__label {
    margin-top: 10px;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
  }

  .tile__count {
    font-size: 12px;
  }

  /* Phones: the only horizontal scroll on the site, inside its own container. */
  @media (max-width: 767px) {
    .tiles__list {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin-inline: calc(var(--gutter) * -1);
      padding: 4px var(--gutter) 8px;
      scrollbar-width: none;
    }

    .tiles__list::-webkit-scrollbar {
      display: none;
    }

    .tiles__list > li {
      scroll-snap-align: start;
      flex: none;
    }
  }
</style>
