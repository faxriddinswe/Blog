---
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { site, socials } from "@/data/site";
import { localePath, locales, t, type Locale, type PageId } from "@/i18n/ui";

interface Props {
  lang: Locale;
  page: PageId | "404";
  title: string;
  description: string;
  /** Home uses the full title as-is; inner pages get " — Faxriddin Baxtiyorov". */
  fullTitle?: boolean;
}

const { lang, page, title, description, fullTitle = false } = Astro.props;
const pageTitle = fullTitle ? title : `${title} — ${site.name}`;
const isPage = page !== "404";
const canonical = isPage ? new URL(localePath(lang, page), site.url).href : undefined;
const ogImage = new URL("/og.png", site.url).href;

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  jobTitle: site.title,
  url: site.url,
  image: new URL("/og.png", site.url).href,
  email: `mailto:${site.email}`,
  address: { "@type": "PostalAddress", addressLocality: "Tashkent", addressCountry: "UZ" },
  alumniOf: { "@type": "CollegeOrUniversity", name: "PDP University" },
  knowsLanguage: ["uz", "en"],
  sameAs: socials.map((s) => s.href),
};
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {
      isPage &&
        locales.map((l) => (
          <link rel="alternate" hreflang={l} href={new URL(localePath(l, page), site.url).href} />
        ))
    }
    {isPage && <link rel="alternate" hreflang="x-default" href={new URL(localePath("uz", page), site.url).href} />}
    {!isPage && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={page === "home" ? "profile" : "website"} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.title}`} />
    <meta property="og:locale" content={t(lang, "meta.lang").replace("-", "_")} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@faxriddinswe" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0A0E14" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F6F7F5" media="(prefers-color-scheme: light)" />

    {/* Theme before first paint: saved choice → system preference → dark. */}
    <script is:inline>
      (function () {
        var theme;
        try { theme = localStorage.getItem("theme"); } catch (e) {}
        if (theme !== "light" && theme !== "dark") {
          theme = matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    {page === "home" && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
  </head>
  <body>
    <a class="skip" href="#main">{t(lang, "skip")}</a>
    <Header lang={lang} page={page} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer bordered={page !== "home"} />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 16px;
    top: -100px;
    z-index: 100;
    padding: 10px 16px;
    border-radius: 12px;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 700;
  }

  .skip:focus {
    top: 12px;
  }

  main:focus {
    outline: none;
  }
</style>
