---
import Icon from "@/components/Icon.astro";
import { site, telegramContact } from "@/data/site";
import { t, type Locale } from "@/i18n/ui";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
---

<section id="contact" class="band" aria-labelledby="contact-title">
  <p class="band__eyebrow">{t(lang, "contact.eyebrow")}</p>
  <h2 id="contact-title" class="band__title">{t(lang, "contact.title")}</h2>
  <p class="band__text">{t(lang, "contact.text")}</p>
  <div class="band__actions">
    <a class="btn btn--lg band__primary" href={telegramContact} target="_blank" rel="noopener noreferrer">
      <Icon name="telegram" />
      {t(lang, "contact.telegram")}
      <Icon name="arrow" />
      <span class="sr-only">({t(lang, "external")})</span>
    </a>
    <a class="btn btn--lg band__secondary" href={`mailto:${site.email}`}>
      <Icon name="mail" />
      <span class="band__email">{site.email}</span>
    </a>
  </div>
</section>

<style>
  .band {
    margin-top: 72px;
    padding: clamp(28px, 5vw, 56px);
    border-radius: 28px;
    background: var(--accent);
    color: #0a0e14;
  }

  .band__eyebrow {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
  }

  .band__title {
    margin-top: 10px;
    max-width: 720px;
    font-size: clamp(26px, 3.4vw, 36px);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.8px;
  }

  .band__text {
    margin-top: 10px;
    font-size: 16px;
  }

  .band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  .band__primary {
    background: #0a0e14;
    border-color: #0a0e14;
    color: #fff;
  }

  .band__primary:hover {
    background: #1b2430;
    border-color: #1b2430;
  }

  .band__secondary {
    background: transparent;
    border: 1.5px solid #0a0e14;
    color: #0a0e14;
    min-width: 0;
  }

  .band__secondary:hover {
    background: rgb(10 14 20 / 0.08);
    border-color: #0a0e14;
  }

  .band__email {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .band :focus-visible {
    outline-color: #0a0e14;
  }

  @media (max-width: 480px) {
    .band__actions .btn {
      flex: 1 1 100%;
      min-width: 0;
      white-space: normal;
    }

    .band__email {
      overflow-wrap: anywhere;
    }
  }
</style>
