# Copy to .env.local and fill in. Never commit real values.

# Public canonical origin (used for metadata, sitemap, OG).
NEXT_PUBLIC_SITE_URL=https://faxriddinswe.uz

# Telegram lead delivery (server-only — never prefix with NEXT_PUBLIC_).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional Cloudflare Turnstile. Leave empty to disable.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
