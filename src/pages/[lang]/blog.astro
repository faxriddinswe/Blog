---
import { Picture } from "astro:assets";
import { articles as allArticles } from "@/data/articles";
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import PageIntro from "@/components/PageIntro.astro";
import { formatDate, langPaths, t, type Locale } from "@/i18n/ui";

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;

// One list, newest first (owner request: no Medium/LinkedIn tiles); the platform shows on each card.
const articles = [...allArticles].sort((a, b) => b.date.localeCompare(a.date));
const platformName = { medium: "Medium", linkedin: "LinkedIn" } as const;
const ext = t(lang, "external");
---

<Base lang={lang} page="blog" title={t(lang, "blog.meta.title")} description={t(lang, "blog.meta.description")}>
  <div class="container page">
    <PageIntro title={t(lang, "blog.h1")} lead={t(lang, "blog.lead")} />

    <div class="grid cards section">
      {
        articles.map((a) => (
          <article class="acard card">
            <a class="acard__cover" href={a.url} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
              {a.cover ? (
                <Picture
                  src={a.cover}
                  alt=""
                  widths={[400, 640, 960]}
                  sizes="(min-width: 1024px) 290px, (min-width: 560px) 45vw, 92vw"
                  formats={["avif", "webp"]}
                  loading="lazy"
                />
              ) : (
                <span class="acard__fallback">
                  <Icon name={a.platform} size={36} />
                </span>
              )}
              <span class="acard__platform">
                <Icon name={a.platform} size={16} />
              </span>
            </a>
            <div class="acard__body">
              <h2 class="acard__title">{a.title[lang]}</h2>
              <p class="acard__meta">
                <span class="pill badge">{platformName[a.platform]}</span>
                <time class="muted" datetime={a.date}>
                  {formatDate(lang, a.date)}
                </time>
              </p>
              <a class="btn btn--accent acard__btn" href={a.url} target="_blank" rel="noopener noreferrer">
                {t(lang, `blog.read.${a.platform}`)}
                <Icon name="external" />
                <span class="sr-only">({ext})</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</Base>

<style>
  .cards {
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    margin-top: 40px;
  }

  .acard {
    display: flex;
    flex-direction: column;
    padding: 10px;
  }

  .acard__cover {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    border-radius: 12px;
    overflow: hidden;
    background: var(--surface-2);
  }

  .acard__cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease);
  }

  .acard__cover:hover :global(img) {
    transform: scale(1.04);
  }

  .acard__fallback {
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--muted);
  }

  .acard__platform {
    position: absolute;
    top: 10px;
    left: 10px;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: rgb(10 14 20 / 0.72);
    backdrop-filter: blur(6px);
    color: #fff;
  }

  .acard__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 10px;
    padding: 14px 6px 6px;
  }

  .acard__title {
    font-size: 16px;
    font-weight: 700;
    line-height: 1.4;
  }

  .acard__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-size: 13px;
  }

  .badge {
    padding: 2px 10px;
    background: var(--accent-soft);
    font-weight: 600;
  }

  .acard__btn {
    align-self: flex-start;
    margin-top: auto;
  }

  @media (max-width: 559px) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
