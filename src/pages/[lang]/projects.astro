---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import PageIntro from "@/components/PageIntro.astro";
import CategoryTiles from "@/components/CategoryTiles.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { telegramContact } from "@/data/site";
import { langPaths, t, type Locale } from "@/i18n/ui";

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;

const all = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const groups = (["personal", "freelance"] as const).map((type) => ({
  type,
  title: t(lang, `projects.${type}`),
  items: all.filter((p) => p.data.type === type),
}));
---

<Base lang={lang} page="projects" title={t(lang, "projects.meta.title")} description={t(lang, "projects.meta.description")}>
  <div class="container page">
    <PageIntro title={t(lang, "projects.h1")} lead={t(lang, "projects.lead")} />
    <CategoryTiles
      label={t(lang, "projects.h1")}
      tiles={groups.map((g) => ({
        href: `#${g.type}`,
        label: g.title,
        count: t(lang, "items", { n: g.items.length }),
        icon: g.type === "personal" ? "folder" : "briefcase",
      }))}
    />

    {
      groups.map((g) => (
        <section id={g.type} class="section" aria-labelledby={`${g.type}-title`}>
          <h2 id={`${g.type}-title`} class="h2 section-head">
            {g.title}
          </h2>
          <div class="grid cards">
            {g.items.map((p) => (
              <ProjectCard lang={lang} project={p.data} />
            ))}
          </div>
        </section>
      ))
    }

    <aside class="cta card">
      <p class="cta__text">{t(lang, "projects.cta")}</p>
      <a class="btn btn--accent btn--lg" href={telegramContact} target="_blank" rel="noopener noreferrer">
        {t(lang, "projects.ctaButton")}
        <Icon name="arrow" />
        <span class="sr-only">({t(lang, "external")})</span>
      </a>
    </aside>
  </div>
</Base>

<style>
  .cards {
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    margin-top: 64px;
    padding: 28px;
    border-radius: 22px;
    border-color: var(--accent-line);
    background:
      radial-gradient(80% 140% at 0% 0%, var(--accent-soft), transparent 70%),
      var(--surface);
  }

  .cta__text {
    font-size: 20px;
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: -0.3px;
  }

  @media (max-width: 559px) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }

    .cta .btn {
      flex: 1 1 100%;
    }
  }
</style>
