---
import { Picture } from "astro:assets";
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import SocialButtons from "@/components/SocialButtons.astro";
import portrait from "@/assets/portrait.png";
import { site } from "@/data/site";
import { langPaths, localePath, t, type Locale } from "@/i18n/ui";

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
---

<Base lang={lang} page="home" title={t(lang, "home.meta.title")} description={t(lang, "home.meta.description")} fullTitle>
  <section class="hero container">
    <div class="photo">
      <Picture
        src={portrait}
        alt={t(lang, "home.photoAlt")}
        width={168}
        height={168}
        densities={[1, 2]}
        formats={["avif", "webp"]}
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <p class="pill badge">
      <span class="dot" aria-hidden="true"></span>
      {t(lang, "home.experience", { n: site.experienceYears })}
    </p>

    <h1 class="name">{site.name}</h1>
    <p class="role">{site.title}</p>
    <p class="loc muted">
      <Icon name="pin" size={18} class="loc__icon" />
      {site.location[lang]}
    </p>

    <SocialButtons lang={lang} size="lg" />

    <div class="cta">
      <a class="btn btn--accent btn--lg" href={site.resume} download>
        <Icon name="download" />
        {t(lang, "home.resume")}
      </a>
      <a class="btn btn--secondary btn--lg" href={localePath(lang, "about")}>
        {t(lang, "home.more")}
        <Icon name="arrow" />
      </a>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: calc(100dvh - var(--header-h) - 74px);
    padding-block: 48px;
    text-align: center;
  }

  .photo {
    padding: 5px;
    border-radius: 50%;
    border: 2px solid var(--accent);
  }

  .photo img {
    width: 168px;
    height: 168px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--surface-2);
  }

  .badge {
    margin-top: 24px;
    padding: 6px 14px;
    border: 1px solid var(--accent-line);
    background: var(--accent-soft);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.4;
  }

  .name {
    margin-top: 18px;
    font-size: 56px;
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -1.6px;
  }

  .role {
    margin-top: 10px;
    font-size: 22px;
    font-weight: 500;
    color: var(--muted);
  }

  .loc {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 8px;
    font-size: 15px;
  }

  .loc :global(.loc__icon) {
    color: var(--accent-text);
  }

  .hero :global(.socials) {
    justify-content: center;
    margin-top: 28px;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 28px;
  }

  @media (max-width: 767px) {
    .name {
      font-size: 36px;
      letter-spacing: -1px;
    }

    .role {
      font-size: 18px;
    }
  }

  @media (max-width: 390px) {
    .cta {
      flex-direction: column;
      align-self: stretch;
    }

    .cta .btn {
      white-space: normal;
      text-align: center;
    }
  }
</style>
