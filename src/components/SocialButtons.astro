---
import Icon from "@/components/Icon.astro";
import { socials } from "@/data/site";
import { t, type Locale } from "@/i18n/ui";

interface Props {
  lang: Locale;
  size?: "md" | "lg";
}
const { lang, size = "md" } = Astro.props;
---

<ul class="socials" aria-label={t(lang, "home.socials")}>
  {
    socials.map((s) => (
      <li>
        <a
          class:list={["icon-btn", { "icon-btn--lg": size === "lg" }]}
          href={s.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${s.label} (${t(lang, "external")})`}
        >
          <Icon name={s.id} />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
</style>
