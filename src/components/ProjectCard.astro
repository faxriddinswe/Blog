---
import type { CollectionEntry } from "astro:content";
import { Picture } from "astro:assets";
import Icon, { type IconName } from "@/components/Icon.astro";
import { t, type Locale } from "@/i18n/ui";

interface Props {
  lang: Locale;
  project: CollectionEntry<"projects">["data"];
}
const { lang, project } = Astro.props;
const glyphs: Record<typeof project.glyph, IconName> = {
  bot: "bot",
  agent: "sparkles",
  web: "globe",
  shop: "cart",
  edu: "cap",
  api: "server",
};
const coverHref = project.live ?? project.github;
const coverLabel = project.live
  ? t(lang, "projects.openSite", { name: project.name })
  : t(lang, "projects.openRepo", { name: project.name });
const ext = t(lang, "external");
---

<article class="pcard card">
  {/* Mouse shortcut to the same link as the buttons below; hidden from AT and Tab to avoid duplicates.
      Banner: CC0 photo matching the project — TODO(owner): real screenshots (see TODO-CONTENT.md). */}
  <a class="cover" href={coverHref} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true" title={coverLabel}>
    <Picture
      src={project.banner}
      alt=""
      widths={[400, 640, 960]}
      sizes="(min-width: 1024px) 290px, (min-width: 560px) 45vw, 92vw"
      formats={["avif", "webp"]}
      loading="lazy"
    />
    <span class="cover__shade"></span>
    <span class="cover__glyph"><Icon name={glyphs[project.glyph]} size={22} /></span>
    <span class="cover__stack">
      {project.stack.slice(0, 3).map((s) => <span>{s}</span>)}
    </span>
  </a>
  <div class="pcard__body">
    <p class="pcard__type">{t(lang, `projects.${project.type}`)}</p>
    <h2 class="pcard__title">{project.name}</h2>
    <p class="pcard__desc muted">{project.description[lang]}</p>
    <div class="pcard__actions">
      {
        project.live && (
          <a class="btn btn--accent" href={project.live} target="_blank" rel="noopener noreferrer">
            {t(lang, "projects.live")}
            <Icon name="external" />
            <span class="sr-only">({ext})</span>
          </a>
        )
      }
      <a class="btn" href={project.github} target="_blank" rel="noopener noreferrer">
        GitHub
        <Icon name="external" />
        <span class="sr-only">({ext})</span>
      </a>
    </div>
  </div>
</article>

<style>
  .pcard {
    display: flex;
    flex-direction: column;
    padding: 10px;
  }

  .cover {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    border-radius: 12px;
    overflow: hidden;
    background: var(--surface-2);
  }

  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease);
  }

  .cover:hover :global(img) {
    transform: scale(1.04);
  }

  /* Darkens the bottom so the stack chips stay readable on any photo. */
  .cover__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(10 14 20 / 0.75), transparent 55%);
  }

  .cover__glyph {
    position: absolute;
    top: 10px;
    left: 10px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: rgb(10 14 20 / 0.72);
    backdrop-filter: blur(6px);
    color: #3ddc97;
  }

  .cover__stack {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 10px;
    display: flex;
    gap: 6px;
    overflow: hidden;
  }

  .cover__stack span {
    flex: none;
    padding: 2px 8px;
    border-radius: 999px;
    background: rgb(10 14 20 / 0.72);
    color: #e8edf2;
    font-size: 11px;
    font-weight: 600;
  }

  .pcard__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 14px 6px 6px;
  }

  .pcard__type {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .pcard__title {
    margin-top: 2px;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.4;
  }

  .pcard__desc {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-top: 4px;
    font-size: 14px;
    line-height: 1.6;
  }

  .pcard__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
    padding-top: 14px;
  }
</style>
